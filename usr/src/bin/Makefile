# AI-ONLY NOTE: not named: ed, which the Lite cut deleted with its
# directory. A name with no directory stops the build here, as
# it stopped Lite2's own make, which ran each command with `sh -ec'
# (docs/deferred.md, *Sources and directories named but absent*).
SUBDIR=	cat chmod cp csh date dd df echo expr hostname kill ln ls \
	mkdir mv pax ps pwd rcp rm rmail rmdir sh sleep stty sync test

.include <bsd.subdir.mk>
