# AI-ONLY NOTE: GNU diff 2.6, as NetBSD 1.0's gnu/usr.bin carried it,
# beside Berkeley's diff, which is the system's (usr.bin/diff): here
# as gdiff, gdiff3 and gsdiff in /usr/contrib/bin, the g that Lite2's
# gzip scripts and later installs of GNU diff beside a BSD one use.
SUBDIR=	diff diff3 sdiff

.include <bsd.subdir.mk>
