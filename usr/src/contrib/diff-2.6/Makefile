# AI-ONLY NOTE: GNU diff 2.6, as NetBSD 1.0's gnu/usr.bin carried it, and
# as there and in FreeBSD 2.0 the system's diff, diff3 and sdiff, in
# /usr/bin, by the maintainer's choice: Lite2 has none, the Lite cut
# having emptied usr.bin/diff, and a diff not derived from
# Caldera-licensed code is preferred to Berkeley's
# (docs/deferred.md, *Caldera's licence, and what the BSDs took under
# it*).
SUBDIR=	diff diff3 sdiff

.include <bsd.subdir.mk>
