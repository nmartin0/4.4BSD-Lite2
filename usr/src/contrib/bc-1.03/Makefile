# AI-ONLY NOTE: GNU bc 1.03 and its dc, as NetBSD 1.1's gnu/usr.bin
# carried them, the system's bc and dc in /usr/bin, by the maintainer's
# choice (decided 2026-10-24): Lite2 has neither, the Lite cut having
# taken Berkeley's, which were AT&T's, and these are the pair all three
# BSDs shipped in the period (docs/provenance/imports.md).
SUBDIR=	bc dc

.include <bsd.subdir.mk>
