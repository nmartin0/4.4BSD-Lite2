#	@(#)Makefile	8.1 (Berkeley) 6/6/93

# AI-ONLY NOTE: old.bin.grep, old.egrep, old.fgrep and old.ucb.grep
# are named here and are not in this tree, nor in 4.4BSD-Lite, whose
# usr.bin/grep also holds egrep alone. Each one ends its entry with
# "can't cd", and the loop's status is the last entry's, so the whole
# directory failed after building what it has. NetBSD 1.0 and FreeBSD
# 2.0.5 removed this directory and build grep as one program, so
# neither has a list to copy; this names what is here.
SUBDIR=	egrep

.include <bsd.subdir.mk>
