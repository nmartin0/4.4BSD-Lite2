#
# LINK -- GENERIC without the drivers 4.4BSD-Lite2 left unfinished.
#
# AI-ONLY NOTE: this configuration is not Berkeley's. It is GENERIC.i386
# with wd, fd and wt removed. wd and fd use the 4.3BSD names for the
# driver queue -- av_forw, b_forw, b_actl -- and struct buf in
# <sys/buf.h> has had b_actf and b_actb since before 4.4BSD-Lite. wt
# has none of those and fails on its own account, at a static
# declaration of cmds after a non-static one; it is left out here with
# the other two rather than fixed in passing.
# 4.4BSD-Lite has the same mixture in the same files, so these drivers
# have never compiled against Berkeley's own header; it is one more piece
# of an unfinished i386 port, like the missing kvm_i386.c.
#
# It exists so the rest of the kernel can be compiled and linked while
# that is decided. GENERIC.i386 is left exactly as Berkeley wrote it.
# Shipping more than one configuration per port is ordinary: NetBSD 1.0's
# i386 conf holds ALL, DISKLESS, GENERICAHA and six others beside
# GENERIC, and FreeBSD 2.0.5's holds GENERIC and LINT.
#
# See docs/provenance/missing.md for what would be needed to build the
# three drivers, and which tree has a donor for them.
#
machine		"i386"
cpu		"i386"
ident		LINK
timezone	8 dst
maxusers	2
options		INET
options		"TCP_COMPAT_42"
options		"COMPAT_43"

config		vmunix	swap on generic

controller	isa0

# AI-ONLY NOTE: pc0 and pcrint, where GENERIC.i386 says cn0 and
# cnrint. In 1991 the console driver really was called cn and lived in
# i386/isa/cons.c, and files.i386 said `optional cn device-driver'.
# The 1992 reorganisation made i386/i386/cons.c the machine-independent
# layer, standard rather than optional, and moved the hardware driver
# to i386/isa/pccons.c as `optional pc device-driver'. GENERIC.i386 was
# not followed through, so it still asks for a driver that no longer
# exists: nothing in this tree defines cndriver, while pccons.c defines
# pcdriver and its handler is pcrint.
#
# The line below is Berkeley's own. Their ARGO and BLITZ configurations
# were updated at the rename and read exactly this; GENERIC.i386 and
# CIRCE were missed. The Lite releases ship only GENERIC.i386, so the
# corrected form is not in this tree -- it is in the CSRG history.
device		pc0	at isa? port "IO_KBD" tty irq 1 vector pcrint
device		npx0	at isa? port "IO_NPX" irq 13 vector npxintr
device		com0	at isa? port "IO_COM1" tty irq 4 vector comintr
device		ne0	at isa? port 0x320 net irq 9 vector neintr
device we0 at isa? port 0x280 net irq 3 iomem 0xd0000 iosiz 8192 vector weintr

pseudo-device	loop
pseudo-device	ether
pseudo-device	sl	1
